# macOS
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp
*.log

# ESP-IDF build output
build/
sdkconfig
sdkconfig.old
*.o
*.a
*.out
*.bin
*.elf
*.map

# ESP-IDF component manager
managed_components/
**/components/.idf/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Local editor settings: regenerated by the ESP-IDF extension and holding
# absolute paths and each machine's serial port. The .devcontainer is
# versioned, because it is portable.
.vscode/

# Credentials used to be compiled in from here. Nothing reads it any more,
# but a copy left behind must never be committed.
main/secrets.h

# Language servers (cache regenerable)
.cache/
.clangd/
.ccls-cache/
compile_commands.json

# Python (tools/font_gen)
__pycache__/
*.pyc
venv/
.venv/

# Vendor datasheets: kept locally for reference, not redistributable
docs/*_datasheet_*.pdf

# Old display driver, kept locally for reference only: it has no license, so
# it must never be published
docs/reference/
